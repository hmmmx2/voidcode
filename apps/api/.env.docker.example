# apps/api/.env.docker.example
# ──────────────────────────────────────────────────────────────────────────────
# Docker-specific environment variables for the GPU backend container.
#
# Copy this file to apps/api/.env.docker and fill in real values before running:
#   cp apps/api/.env.docker.example apps/api/.env.docker
#
# This file is mounted read-only into the container:
#   volumes:
#     - ./apps/api/.env.docker:/app/.env:ro
#
# NEVER commit .env.docker — it contains secrets.
# .env* is already in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── vLLM Engine ───────────────────────────────────────────────────────────────
# These are also set in docker-compose.gpu.yml; values here are loaded by
# python-dotenv at startup and serve as a fallback / documentation.

USE_VLLM=true
MODEL_PATH=/models/awq_model
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192
VLLM_QUANTIZATION=compressed-tensors
VLLM_DTYPE=float16

# Concurrency: max simultaneous LLM requests accepted by the endpoint.
# vLLM queues and batches them internally — setting too low wastes GPU capacity.
MAX_CONCURRENT_REQUESTS=8

# ── Database (Docker network hostnames — NOT localhost) ───────────────────────
# Inside the Docker network, services are reachable by service name + container port.
# postgres:5432  (NOT localhost:5433 — that's the host-exposed port)
# redis:6379     (NOT localhost:6380)

DATABASE_URL=postgresql+asyncpg://alwin:alwin_dev@postgres:5432/alwin_tutor
DATABASE_URL_SYNC=postgresql://alwin:alwin_dev@postgres:5432/alwin_tutor
REDIS_URL=redis://redis:6379/0
JUDGE0_BASE_URL=http://judge0-server:2358

# ── LLM Model ─────────────────────────────────────────────────────────────────
# Used to download the tokenizer if not present in the model dir.
# The AWQ model directory already bundles tokenizer files, so this is
# only a fallback — the container does NOT need internet access to start.
BASE_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# ── Auth & Security ───────────────────────────────────────────────────────────
#
# SECRET_KEY and NEXTAUTH_SECRET used to be documented here. NOTHING IN THIS REPO
# READS EITHER OF THEM — they were cargo-culted from a different stack, and an
# operator who set them would reasonably believe the service was configured when
# none of the real variables were. NextAuth's secret is AUTH_SECRET and belongs in
# apps/web, not here. They are removed rather than left as false reassurance.
#
# Everything below is read by apps/api/src/config.py, which refuses to start with
# APP_ENV=production if any of it is missing or still a default.

APP_ENV=production

# The origin the FRONTEND is served from. Every emailed link is built from this and
# NEVER from the request Host header — nginx forwards whatever the client sent, so
# a host-header injection would rewrite reset links to an attacker's domain.
# The public site's origin — the landing/download page and the Stripe return pages (`site/`).
APP_BASE_URL=https://your-site-domain

# Signs the identity that the Next.js proxy forwards. MUST equal
# INTERNAL_API_SECRET in apps/web, or every signed request comes back 401.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Leave false until the web app is deployed with the proxy, then flip to true. The
# header has to ship in the browser tier BEFORE this tier starts rejecting requests
# without it, or sign-in breaks in the window between two deploys.

# Salts emails before they become Redis rate-limit keys, so an unencrypted cache
# never holds a plaintext list of every address anyone tried to sign in as.
RATELIMIT_PEPPER=

# How many proxy hops YOU run, for reading the real client IP out of
# X-Forwarded-For. 0 means trust nothing and use the socket address. Over-declaring
# is as dangerous as under-declaring: it lets a client inject its own bucket.
TRUSTED_PROXY_HOPS=1

# Optional; the defaults in config.py are the intended values. Listed so the
# template stays a complete inventory of what config.py reads — a template that
# documents a subset is how an operator ends up believing a variable does not exist.
VERIFY_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=60

# ── Email ────────────────────────────────────────────────────────────────────
# 'console' only logs the link. Production refuses to start in that mode, because
# it means every password reset silently fails.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=VoidCode AI <noreply@your-verified-domain>

# ── Judge0 ───────────────────────────────────────────────────────────────────
# Judge0 runs untrusted code in a PRIVILEGED container. Two DIFFERENT secrets: the
# admin token can read every submission ever made.
JUDGE0_AUTH_TOKEN=
JUDGE0_ADMIN_TOKEN=

# ── CORS / Allowed Origins ────────────────────────────────────────────────────
# Add your production frontend URL here. Required — with APP_ENV=production there is
# no localhost fallback and no tunnel regex, so an empty value rejects your own
# frontend. The tunnel allowance this file used to describe was a DEVELOPMENT-only
# convenience and is now dropped in production; anyone can stand up a free
# cloudflared tunnel and it was granted credentialed access.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── GPU credit metering ──────────────────────────────────────────────────────
# Two switches, not one. METERING takes reservations and settles them against measured slot
# occupancy; ENFORCE turns on refusal (402 before the pod runs). Measuring first is what lets a
# price be chosen from observed data instead of guessed. Both OFF means the request path behaves
# exactly as it did before metering existed — there are no wallets yet.
GPU_METERING_ENABLED=false
GPU_BILLING_ENFORCE=false

# The ceiling a request may occupy a slot for, in seconds. This is what gets HELD up front, so a
# learner who cannot afford the worst case is refused before generation rather than during it.
GPU_MAX_SLOT_SECONDS=180

# Minimum charge per request, in micro-credits (1 credit = 1_000_000). A one-token reply still
# occupied a slot; without a floor a flood of trivial requests runs the pod at a loss.
GPU_FLOOR_MICRO=1000

# How often each replica sweeps for stranded holds, and how old a hold must be before it counts as
# stranded. The age must be comfortably beyond any legitimate request, or the sweep races the settle
# it exists to back up and voids requests that were merely slow.
GPU_SWEEP_INTERVAL_SECONDS=300
GPU_SWEEP_MAX_AGE_SECONDS=900

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Set these in your OWN environment or secrets manager. They are never read from the database, never
# logged, and never returned by any endpoint. Leave them empty here.
#
# STRIPE_SECRET_KEY authenticates calls TO Stripe. STRIPE_WEBHOOK_SECRET verifies bodies coming FROM
# Stripe. They are different values, issued separately, and rotate independently — swapping them
# silently breaks both directions.
#
# Get them from the Stripe Dashboard: the secret key under Developers > API keys (use the TEST key,
# sk_test_..., until you are ready), and the webhook secret (whsec_...) shown when you add an
# endpoint under Developers > Webhooks pointing at POST /v1/credits/webhook with the
# checkout.session.completed event.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Master switch. Off means /v1/credits/checkout returns 503 rather than half-working. The API
# refuses to start with this on and either secret missing, so a misconfigured deploy fails at boot
# rather than at the till.
PAYMENTS_ENABLED=false

# ── Withholding the answer ───────────────────────────────────────────────────
# Refuse to deliver a complete solution to the exercise the learner has open,
# whatever the model decided to say. The protected function name is read from the
# learner's own submitted code, so no answer key is loaded on the serving path.
#
# DEFAULTS TRUE, unlike every other flag in this file, because it is the only
# mechanism that can promise the product's central claim. Measured 2026-09-10:
# every prompt forbids handing over the solution, at length, and the 30B did it
# anyway in 4 of 6 pressured conversations. A prompt is a request; this is a
# check on the way out.
#
# Set false only to measure raw model behaviour. See src/withholding.py.
WITHHOLD_SOLUTIONS=true

# ── Inference backend ────────────────────────────────────────────────────────
# Which engine serves inference, where it lives, and how many requests may be in
# flight in one process. These were inline in main.py and therefore undocumented
# here; see config.py for why each value is what it is.
#
# USE_SGLANG and USE_VLLM are mutually exclusive in practice. Both false uses
# HuggingFace model.generate() in-process, which is the local-development path.
USE_SGLANG=false
# Where the SGLang container answers. The default is the compose service name;
# it is NOT re-read after startup, so a backend that moves needs a restart.
SGLANG_BASE_URL=http://sglang-server:30000/v1
# The alias the backend exposes for the model to serve — NOT a model id, and a
# server can expose several under different names. Leave EMPTY to use whatever
# the backend serves when it serves exactly one; set it explicitly when there is
# more than one, or startup logs an error naming the options rather than
# guessing. It shipped as `default`, which no backend here answers to: every
# request 404'd with "The model `default` does not exist".
SGLANG_MODEL_NAME=
# Client timeout to that backend, in seconds. Must exceed the longest generation
# any mode can ask for: 8192 tokens at ~18.6 tok/s is ~440 s.
SGLANG_TIMEOUT_SECONDS=900
# Per-process concurrency cap. Leave unset to take the per-backend default
# (SGLang 16, vLLM 8, HuggingFace 2). This is per replica, not per fleet.

# ── GPU serving queue ────────────────────────────────────────────────────────
# Off means the chat endpoint 503s the instant this process is at capacity, as
# it always has. On means a streaming request waits for a fleet-wide slot
# instead, which is what makes the concurrency limit mean anything across
# replicas. Non-streaming requests are never queued: they have no channel to
# report a position and the proxy's 300s read timeout is a hard total for them.
GPU_QUEUE_ENABLED=false
# Seconds a streaming request will wait. Bounded by what the proxies tolerate,
# not by patience: headers are not sent until the wait ends.
GPU_QUEUE_MAX_WAIT_SECONDS=120
# Refuse at the door past this depth rather than admit to an unservable queue.
GPU_QUEUE_MAX_DEPTH=50

# ── GPU provider (pod lifecycle) ─────────────────────────────────────────────
# Off means the API never starts or stops a pod. Leave it off unless this
# deployment owns its own GPU pod and you want it spun down when idle.
#
# The API key is ACCOUNT-WIDE: it can address every pod in the account. The code
# refuses to act unless RUNPOD_POD_ID names exactly one, and offers no way to
# name another. Leave the key empty here and set it in the environment.
POD_CONTROL_ENABLED=false
RUNPOD_API_KEY=
# The single pod this service may start and stop. An identifier, not a secret.
RUNPOD_POD_ID=

# ── Spin-down ────────────────────────────────────────────────────────────────
# Stop the GPU pod when nobody is using it. Needs POD_CONTROL_ENABLED too.
# Leave off unless this deployment owns its own pod: the first request after a
# stop waits for a cold start, which was measured at ~560s for a 16 GB model.
SPINDOWN_ENABLED=false
# Seconds with nothing settled before the pod counts as idle.
SPINDOWN_IDLE_SECONDS=1200
SPINDOWN_CHECK_SECONDS=120

# ── Desktop sign-in ──────────────────────────────────────────────────────────
# How long a signed-in desktop client stays signed in, in days. Months rather
# than hours: the alternative is asking someone to retype a password into a
# native app every week, which trains them to type it wherever it is asked for.
# Sessions are revocable per device, which matters more than a short lifetime.
DESKTOP_SESSION_TTL_DAYS=90

# ── Google and Microsoft sign-in (desktop) ───────────────────────────────────
# Public client ids, comma-separated. Empty disables that provider: its button is
# hidden in the desktop app and nothing else changes. Register a Google "Desktop
# app" client and a Microsoft Entra public client; see docs for exact settings.
OAUTH_GOOGLE_CLIENT_IDS=
# Google's desktop client still needs its secret at the token endpoint. Server
# side ONLY — the desktop app relays the code here precisely so this never ships
# in an installer. Required whenever OAUTH_GOOGLE_CLIENT_IDS is set.
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_IDS=
# Optional Microsoft tenant allowlist, comma-separated. Empty = any tenant,
# including personal Microsoft accounts.
OAUTH_MICROSOFT_ALLOWED_TENANTS=

# ── Password reset by emailed code (desktop) ────────────────────────────────
# HMAC key for stored reset codes, at least 32 random characters. Without it a
# leaked auth_tokens table reverses every outstanding six-digit code. Rotating
# it invalidates outstanding codes and nothing else.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_CODE_SECRET=
PASSWORD_RESET_CODE_TTL_MINUTES=15
# Wrong guesses allowed per code before it is dead.
PASSWORD_RESET_CODE_MAX_ATTEMPTS=5
