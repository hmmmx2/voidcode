# === Database (PostgreSQL) ===
DATABASE_URL=postgresql+asyncpg://alwin:alwin_dev@localhost:5433/alwin_tutor
# Sync URL for Alembic CLI (uses psycopg2 driver)
DATABASE_URL_SYNC=postgresql://alwin:alwin_dev@localhost:5433/alwin_tutor

# === Redis ===
REDIS_URL=redis://localhost:6380/0

# === Judge0 ===
# ⚠ WSL2 NOTE: Docker runs on Windows, but FastAPI runs in WSL2.
# From WSL2, "localhost" is WSL2's own loopback — NOT the Windows Docker host.
# Get the Windows host IP from WSL2: cat /etc/resolv.conf | grep nameserver | awk '{print $2}'
# Then set: JUDGE0_BASE_URL=http://<windows-host-ip>:2358
# Example:  JUDGE0_BASE_URL=http://172.29.48.1:2358
JUDGE0_BASE_URL=http://localhost:2358

# Judge0 runs untrusted code in a PRIVILEGED container, so its port is an
# arbitrary-code-execution endpoint. These gate it. Must match AUTHN_TOKEN and
# AUTHZ_TOKEN on the judge0-server service in docker-compose.yml.
#
# Two DIFFERENT secrets, not one: the admin token can read every submission ever
# made, so sharing a value means a leaked run token is also an admin token.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JUDGE0_AUTH_TOKEN=
JUDGE0_ADMIN_TOKEN=

# === LLM Model ===
BASE_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
ADAPTER_PATH=../../llm/outputs/final_model

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=true

# === Environment ===
# "development" or "production". Production changes real behaviour:
#   - CORS drops the tunnel regex entirely and uses ALLOWED_ORIGINS only
#   - the process REFUSES TO START if any secret below is missing
# See src/config.py:assert_production_config.
APP_ENV=development

# === CORS / Frontend URLs ===
# Comma-separated list of allowed frontend origins.
#
# In DEVELOPMENT the backend also allows a regex covering any localhost port and
# any *.trycloudflare.com / *.ngrok*.app / *.loca.lt tunnel, because free tunnel
# hostnames rotate on every restart and cannot be pinned.
#
# In PRODUCTION that regex is dropped entirely — with allow_credentials=True it
# means anyone can stand up a free tunnel and get a credentialed cross-origin
# allowance against this API. Production requires exact origins here, and the
# app will not boot with this empty.
#
# ⚠ Before setting APP_ENV=production you need a NAMED cloudflared tunnel with a
# stable hostname. Otherwise the next tunnel restart changes the origin and the
# frontend breaks with a CORS error that looks like an app bug.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# === Auth: internal service-to-service secret ===
# Every /v1/auth call comes from the Next.js server, never from a browser.
# This secret proves that. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The SAME value must be set as INTERNAL_API_SECRET in apps/web/.env.local.
INTERNAL_API_SECRET=

# Two-phase rollout. Leave false until the web app is deployed and sending the
# X-Internal-Auth header; flipping it early rejects every sign-in. Phase 2 is a
# config change only — no code deploy, and the rollback is this one variable.
INTERNAL_AUTH_ENFORCE=false

# Master switch for email+password auth. OAuth is unaffected either way.
ENABLE_PASSWORD_AUTH=true

# === Auth: rate limiting ===
# Salts emails before they become Redis keys, so a cache dump does not yield a
# plaintext list of every address anyone has tried. Change this from the default.
RATELIMIT_PEPPER=

# How many proxy hops you control (cloudflared → nginx → next = 3).
# 0 means "trust nothing, use the socket address". Set this WRONG-HIGH and a
# client can spoof X-Forwarded-For to pick its own rate-limit bucket.
TRUSTED_PROXY_HOPS=0

# === Auth: token lifetimes ===
VERIFY_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=60

# === Email ===
# "console" logs the link at INFO instead of sending — the default, so local
# development needs no account. Production must be a real provider.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=VoidCode AI <onboarding@resend.dev>

# The origin EMAILED LINKS point at — the frontend, not this API.
# Never derived from the request Host header: nginx forwards Host verbatim, so
# host-header injection would rewrite password-reset links to another domain.
APP_BASE_URL=http://localhost:3000

# ── GPU credit metering ──────────────────────────────────────────────────────
# Two switches, not one. METERING takes reservations and settles them against measured slot
# occupancy; ENFORCE turns on refusal (402 before the pod runs). Measuring first is what lets a
# price be chosen from observed data instead of guessed. Both OFF means the request path behaves
# exactly as it did before metering existed — there are no wallets yet.
GPU_METERING_ENABLED=false
GPU_BILLING_ENFORCE=false

# The ceiling a request may occupy a slot for, in seconds. This is what gets HELD up front, so a
# learner who cannot afford the worst case is refused before generation rather than during it.
GPU_MAX_SLOT_SECONDS=180

# Minimum charge per request, in micro-credits (1 credit = 1_000_000). A one-token reply still
# occupied a slot; without a floor a flood of trivial requests runs the pod at a loss.
GPU_FLOOR_MICRO=1000

# How often each replica sweeps for stranded holds, and how old a hold must be before it counts as
# stranded. The age must be comfortably beyond any legitimate request, or the sweep races the settle
# it exists to back up and voids requests that were merely slow.
GPU_SWEEP_INTERVAL_SECONDS=300
GPU_SWEEP_MAX_AGE_SECONDS=900

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Set these in your OWN environment or secrets manager. They are never read from the database, never
# logged, and never returned by any endpoint. Leave them empty here.
#
# STRIPE_SECRET_KEY authenticates calls TO Stripe. STRIPE_WEBHOOK_SECRET verifies bodies coming FROM
# Stripe. They are different values, issued separately, and rotate independently — swapping them
# silently breaks both directions.
#
# Get them from the Stripe Dashboard: the secret key under Developers > API keys (use the TEST key,
# sk_test_..., until you are ready), and the webhook secret (whsec_...) shown when you add an
# endpoint under Developers > Webhooks pointing at POST /v1/credits/webhook with the
# checkout.session.completed event.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Master switch. Off means /v1/credits/checkout returns 503 rather than half-working. The API
# refuses to start with this on and either secret missing, so a misconfigured deploy fails at boot
# rather than at the till.
PAYMENTS_ENABLED=false

# ── Inference backend ────────────────────────────────────────────────────────
# Which engine serves inference, where it lives, and how many requests may be in
# flight in one process. These were inline in main.py and therefore undocumented
# here; see config.py for why each value is what it is.
#
# USE_SGLANG and USE_VLLM are mutually exclusive in practice. Both false uses
# HuggingFace model.generate() in-process, which is the local-development path.
USE_VLLM=false
USE_SGLANG=false
# Where the SGLang container answers. The default is the compose service name;
# it is NOT re-read after startup, so a backend that moves needs a restart.
SGLANG_BASE_URL=http://sglang-server:30000/v1
SGLANG_MODEL_NAME=default
# Client timeout to that backend, in seconds. Must exceed the longest generation
# any mode can ask for: 8192 tokens at ~18.6 tok/s is ~440 s.
SGLANG_TIMEOUT_SECONDS=900
# Per-process concurrency cap. Leave unset to take the per-backend default
# (SGLang 16, vLLM 8, HuggingFace 2). This is per replica, not per fleet.
MAX_CONCURRENT_REQUESTS=

# ── GPU serving queue ────────────────────────────────────────────────────────
# Off means the chat endpoint 503s the instant this process is at capacity, as
# it always has. On means a streaming request waits for a fleet-wide slot
# instead, which is what makes the concurrency limit mean anything across
# replicas. Non-streaming requests are never queued: they have no channel to
# report a position and the proxy's 300s read timeout is a hard total for them.
GPU_QUEUE_ENABLED=false
# Seconds a streaming request will wait. Bounded by what the proxies tolerate,
# not by patience: headers are not sent until the wait ends.
GPU_QUEUE_MAX_WAIT_SECONDS=120
# Refuse at the door past this depth rather than admit to an unservable queue.
GPU_QUEUE_MAX_DEPTH=50
