# apps/web environment.
#
# Copy to .env.local. This file did not exist, so the eight variables below had to
# be reverse-engineered from src/auth.ts and src/lib/api/client.ts to run the app
# at all — a fresh clone could not be started without reading the source.
#
# Anything prefixed NEXT_PUBLIC_ is INLINED INTO THE BROWSER BUNDLE by Next.js.
# Never put a secret behind that prefix. Everything else here is server-only.


# ── API ──────────────────────────────────────────────────────────────────────

# Where the FastAPI backend lives. Public, because src/auth.ts and the register
# route handler read it — both run server-side, but the var is also the fallback
# for API_INTERNAL_URL below.
#
# NOTE ON PORT 8000: SYNTHIEN also defaults to 8000. It is a completely separate
# project and the two must never talk to each other, so if you run both, give
# VoidCode a different port here and start the API with `--port <that port>`.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. The address the Next.js server uses to reach the API, when that
# differs from the public one — a Kubernetes service name, say. Falls back to
# NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://voidcode-api:8000

# Signs the identity that src/app/api/proxy/[...path]/route.ts forwards to the
# API. MUST equal INTERNAL_API_SECRET in apps/api/.env, or every signed request
# comes back 401.
#
# This is why browser calls go through /api/proxy instead of straight to the API:
# the browser used to assert its own identity with an unsigned X-User-Id header,
# and anyone could send somebody else's UUID. Server-only — see
# apps/api/src/identity.py.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=


# ── NextAuth v5 ──────────────────────────────────────────────────────────────

# Signs and encrypts the session cookie. Rotating it invalidates every session.
#   npx auth secret
AUTH_SECRET=

# The canonical origin of THIS app. OAuth callbacks are built from it, so a stale
# value breaks sign-in with a redirect_uri mismatch rather than an obvious error.
# If you use a tunnel, this and NEXT_PUBLIC_API_URL must both be updated.
AUTH_URL=http://localhost:3000

# Required behind a proxy that terminates TLS, which includes every tunnel and
# any Kubernetes ingress. Without it NextAuth builds http:// callbacks.
AUTH_TRUST_HOST=true


# ── OAuth providers ──────────────────────────────────────────────────────────
#
# Optional. Omitting a pair disables that button; credentials sign-in still works.

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# ── The download section ─────────────────────────────────────────────────────
#
# `owner/name` of the GitHub repository that publishes the desktop installers. The landing page's
# download section reads the latest release from it — file names, sizes and SHA-256 digests — so
# nothing about a release is hand-copied into this repository.
#
# EMPTY IS A VALID STATE, and the correct one today: this project has no git remote yet. The
# section then says the first release has not been published rather than drawing a button that
# 404s. Public value, safe to commit: it is a repository name, not a credential.
NEXT_PUBLIC_RELEASES_REPO=
