# The website's environment. Copy to `.env.local`.
#
# THREE VARIABLES, AND THIS FILE USED TO LIST TEN.
#
# It documented `NEXT_PUBLIC_API_URL`, `API_INTERNAL_URL`, `INTERNAL_API_SECRET`, `AUTH_SECRET`,
# `AUTH_URL`, `AUTH_TRUST_HOST` and five OAuth provider credentials — and instructed a fresh clone
# to generate two secrets before starting. NONE OF THEM WAS READ BY ANY FILE IN `src/`. They
# belonged to the website's server-side auth proxy and its NextAuth session, both of which were
# removed when sign-in moved into the desktop application; `src/auth.ts` does not exist.
#
# That is worse than untidy. A template that asks for a secret implies something uses it, so the
# next person generates one, sets it in Vercel, and believes this site holds a credential. It holds
# none. Checked rather than assumed: `grep -rhoE "process\.env\.[A-Z_0-9]+" src` returns exactly
# what is below plus `NODE_ENV` and Vercel's own `VERCEL_PROJECT_PRODUCTION_URL`.
#
# ANYTHING PREFIXED `NEXT_PUBLIC_` IS INLINED INTO THE BROWSER BUNDLE by Next.js, at BUILD time —
# not read at runtime. Changing one in Vercel requires a redeploy to take effect. Never put a
# secret behind that prefix; there is no secret here to put.


# ── Where the installers come from ───────────────────────────────────────────
#
# `owner/name` of the GitHub repository that publishes each platform's installers. The download
# page reads the latest release from each — file names, sizes and SHA-256 digests — so nothing
# about a release is ever hand-copied into this repository, where it would go stale beside a fresh
# installer.
#
# ONE PER PLATFORM, AND THEY ARE INDEPENDENT. A single repository meant one rate-limited response
# blanked the whole section: GitHub allows 60 anonymous requests an hour per IP, which a shared
# office network exhausts. Now a macOS feed that cannot be read no longer hides the Windows
# installer, and each panel reports its own state.
#
# EMPTY IS A VALID STATE, and the correct one until the first release is published: that platform's
# panel says so instead of drawing a button that 404s. Public values, safe to commit — they are
# repository names, not credentials.
NEXT_PUBLIC_RELEASES_REPO_MAC=
NEXT_PUBLIC_RELEASES_REPO_WIN=


# ── This site's own origin ───────────────────────────────────────────────────
#
# Next resolves every relative metadata URL against this — the Open Graph image above all. Unset,
# it falls back to Vercel's `VERCEL_PROJECT_PRODUCTION_URL` and then to http://localhost:3000, so a
# misconfigured deploy ships a social card pointing at a machine nobody can reach. THE FAILURE IS
# INVISIBLE LOCALLY: only crawlers see it.
#
# Server-only, deliberately — no `NEXT_PUBLIC_` prefix, because `metadata` is evaluated on the
# server and this does not belong in the browser bundle.
#
# It was called `AUTH_URL`, which was NextAuth's variable. Nothing here signs anything now, and on
# Vercel that name is one people set expecting an auth library to read it.
SITE_URL=http://localhost:3000
