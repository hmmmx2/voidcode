{
  // `tests/ui/` is typechecked under the RENDERER's rules, not this root's, and that is the whole
  // reason this file exists rather than one more line in `tsconfig.json`.
  //
  // A component test imports a real renderer component, so `tsc` compiles that component — and the
  // root program compiles it against the wrong contract in two ways. It does not see
  // `renderer/src/types/host.d.ts`, so `VoidCodeHost`, `window.host` and `HostProviderStatus` are
  // all "cannot find name"; and it sets `exactOptionalPropertyTypes` and `noUncheckedIndexedAccess`,
  // which the renderer does not, so `subtitle: string | undefined` passed to `subtitle?: string`
  // is an error here and correct there. Twenty errors, none of them a defect: the renderer's own
  // `tsc --noEmit` is clean on the same files.
  //
  // Extending the renderer's config is what makes the check MEAN something — it asks the same
  // question the shipped bundle asks. `include` and `paths` are both replaced rather than merged
  // (a derived config's `include` overrides the base's outright, and `paths` is swapped whole), so
  // everything the tests need is spelled out below relative to THIS directory.
  "extends": "./renderer/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./renderer/src/*"],
      "@shared/*": ["./src/shared/*"],
      // Same lesson as `@monaco-editor/react` in `tsconfig.json`: these live in the renderer's own
      // install, and a file under `tests/` resolves against this root and finds nothing. They have
      // to be declared HERE and in `vitest.config.ts` — adding to only one is silent, the tests
      // pass and the typecheck fails.
      "@testing-library/react": ["./renderer/node_modules/@testing-library/react"],
      "@testing-library/user-event": ["./renderer/node_modules/@testing-library/user-event"]
    }
  },
  // `host.d.ts` is listed explicitly: the renderer picks it up through its own `**/*.ts` glob, and
  // that glob is gone once `include` is replaced.
  "include": ["renderer/src/types/host.d.ts", "tests/ui/**/*.ts", "tests/ui/**/*.tsx"]
}
