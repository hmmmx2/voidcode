{
  "name": "voidcode-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @voidcode/web dev",
    "dev:api": "cd apps/api && python -m uvicorn src.main:app --host 127.0.0.1 --port 8000",
    "build:web": "pnpm --filter @voidcode/web build",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "pnpm@9.0.0"
}
