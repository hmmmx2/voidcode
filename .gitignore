# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the documented templates must be tracked. `.env*` was swallowing them, so
# NEITHER apps/api/.env.example NOR apps/web/.env.example was ever committed: both
# existed only on this machine, and a fresh clone had to reverse-engineer every
# required variable out of config.py, auth.ts and client.ts. These files contain
# names and comments, never values.
!.env.example
!*/.env.example
!**/.env.example
!**/.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo

